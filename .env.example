# ==============================================================================
# Library Management System - Environment Variables
# ==============================================================================

# MongoDB Configuration (Local Standalone Community or Atlas)
# Local default: mongodb://127.0.0.1:27017
# Atlas example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=library_db

# Neo4j Configuration (Local Desktop 2 or AuraDB Free)
# Local default: bolt://127.0.0.1:7687
# AuraDB example: neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=librarypassword
NEO4J_DATABASE=neo4j

# Application & API Server
PORT=8000
HOST=127.0.0.1
DEBUG=True
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
